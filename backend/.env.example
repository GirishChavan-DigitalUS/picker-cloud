# Picker Backend — Environment Variables
# Copy to .env in the project root and fill in values.
# See also: backend/config.py, backend/auth.py

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/opt/picker/backend/picker.db

# ── Authentication ────────────────────────────────────────────────────────────
# Random >=32 chars (required in production). Auto-generated if not set.
PICKER_AUTH_SECRET=
# Path to htpasswd file (created by deploy/setup-auth.sh)
PICKER_HTPASSWD_PATH=/etc/nginx/.htpasswd-picker
# Dev-only plaintext fallback credentials (ignored when htpasswd file exists)
PICKER_DEV_USER=
PICKER_DEV_PASS=
# Set "0" for plain-HTTP local development (default "1")
PICKER_COOKIE_SECURE=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. Defaults to localhost:5173,4173 + production domain.
ALLOWED_ORIGINS=

# ── Scheduler ─────────────────────────────────────────────────────────────────
FETCH_INTERVAL=120

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: python -c "from pywebpush import webpush; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem()); print(v.public_key)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=admin@nysepicker.duckdns.org

# ── LLM Commentary (optional) ────────────────────────────────────────────────
# Providers: gemini | openai | anthropic | ollama | disabled
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=
