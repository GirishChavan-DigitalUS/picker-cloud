# Force LF line endings for files that must run on Linux (shell scripts,
# systemd units, nginx configs). Without this, files committed from Windows
# may end up CRLF on disk after clone, breaking shebang interpretation and
# producing confusing "command not found" errors for valid scripts.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
deploy/**   text eol=lf
